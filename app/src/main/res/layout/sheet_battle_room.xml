<?xml version="1.0" encoding="utf-8"?>
<!-- 好友对战房间底部弹窗：入口选择(创建/加入) + 建房等待面板 + 加入输入面板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="28dp">

    <!-- 顶部灰色拖拽条（DEBUG 包长按标题可进入回环自测） -->
    <View
        android:layout_width="40dp"
        android:layout_height="5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/battleSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="好友对战"
        android:textColor="#333333"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 入口：创建 / 加入 -->
    <LinearLayout
        android:id="@+id/battleChoiceRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp">

        <Button
            android:id="@+id/battleBtnCreate"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battle_button"
            android:text="创建房间"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/battleBtnJoin"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_battle_button"
            android:text="加入房间"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 建房面板：大号房间号 + 等待提示 -->
    <LinearLayout
        android:id="@+id/battleCreatePanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/battleRoomCodeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/brand_dark"
            android:textIsSelectable="true"
            android:textSize="38sp"
            android:textStyle="bold"
            tools:text="123 456" />

        <TextView
            android:id="@+id/battleCreateHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="14dp"
            android:text="创建中…"
            android:textColor="@color/panel_text_dark"
            android:textSize="15sp" />

        <Button
            android:id="@+id/battleBtnShare"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_battle_button"
            android:text="房号分享给好友"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/battleBtnCancelCreate"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_battle_button"
            android:text="取消"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 加入面板：6 位房间号输入 -->
    <LinearLayout
        android:id="@+id/battleJoinPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/battleRoomInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:hint="输入 6 位房间号"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="@color/brand_dark"
            android:textSize="24sp" />

        <Button
            android:id="@+id/battleBtnConfirmJoin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_battle_button"
            android:text="加入"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>

</LinearLayout>
